<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">
            <TextView android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/circle_green" android:gravity="center" android:text="MR" android:textColor="@color/surface" android:textSize="18sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Marco Rossi" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Grado di affidabilita: 9.2/10" android:textColor="@color/outly_green" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp" android:background="@drawable/rounded_card" android:gravity="center_vertical" android:padding="16dp" android:text="Modifica profilo" android:textColor="@color/text_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/rounded_card" android:gravity="center_vertical" android:padding="16dp" android:text="Richiedi riconoscimento organizzatore" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/logoutButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/rounded_card" android:gravity="center_vertical" android:padding="16dp" android:text="Esci" android:textColor="#B42318" />
    </LinearLayout>
</ScrollView>
