<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:id="@+id/loginScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="visible">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="72dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/circle_green"
                android:gravity="center"
                android:text="O"
                android:textColor="@color/surface"
                android:textSize="42sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bentornato"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="28dp"
                android:text="Accedi e trova qualcosa da fare"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
            <EditText
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/rounded_card"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="16dp" />
            <EditText
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/rounded_card"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="16dp" />
            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/rounded_green"
                android:text="Accedi"
                android:textAllCaps="false"
                android:textColor="@color/surface"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/registerLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Non hai un account? Registrati"
                android:textColor="@color/outly_green"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/appScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="outly"
                android:textColor="@color/outly_green"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/circle_green"
                android:gravity="center"
                android:text="MR"
                android:textColor="@color/surface"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <include
                android:id="@+id/homeScreen"
                layout="@layout/screen_home" />
            <include
                android:id="@+id/searchScreen"
                layout="@layout/screen_search"
                android:visibility="gone" />
            <include
                android:id="@+id/bookingsScreen"
                layout="@layout/screen_bookings"
                android:visibility="gone" />
            <include
                android:id="@+id/profileScreen"
                layout="@layout/screen_profile"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/surface"
            android:elevation="12dp"
            android:orientation="horizontal">
            <Button android:id="@+id/navHome" style="@style/NavButton" android:text="Home" />
            <Button android:id="@+id/navSearch" style="@style/NavButton" android:text="Cerca" />
            <Button android:id="@+id/navBookings" style="@style/NavButton" android:text="Prenotazioni" />
            <Button android:id="@+id/navProfile" style="@style/NavButton" android:text="Profilo" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
